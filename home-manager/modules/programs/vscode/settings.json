{
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontFamily": "Fira Code",
  "window.menuBarVisibility": "toggle",
  "editor.fontSize": 12,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 0,
  "security.workspace.trust.untrustedFiles": "newWindow",
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.enabled": false,
  "editor.minimap.side": "left",
  "extensions.autoUpdate": "off",
  "terminal.external.linuxExec": "kitty",
  "terminal.explorerKind": "both",
  "terminal.sourceControlRepositoriesKind": "both",
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.enableImages": true,
  "editor.suggest.showStatusBar": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "python": true
  },
  "editor.insertSpaces": false,
  "github.copilot.chat.codesearch.enabled": true,
  "python.analysis.typeCheckingMode": "basic",
  "svelte.enable-ts-plugin": true,
  "python.defaultInterpreterPath": "/usr/bin/python",
  "editor.largeFileOptimizations": false,
  "chat.agent.maxRequests": 50,
  "terminal.integrated.inheritEnv": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
  "diffEditor.codeLens": true,
  "editor.aiStats.enabled": true,
  "explorer.fileNesting.enabled": true,
  "workbench.productIconTheme": "fluent-icons",
  "terminal.integrated.fontFamily": "monospace",
  "terminal.integrated.fontLigatures.enabled": true,
  "workbench.settings.applyToAllProfiles": [],
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "workbench.settings.openDefaultKeybindings": true,
  "editor.fontLigatures": true,
  "[latex]": {
    "editor.defaultFormatter": "mathematic.vscode-latex"
  },
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "claudeCode.preferredLocation": "panel",
  "roo-cline.allowedCommands": [
    "git log",
    "git diff",
    "git show"
  ],
  "roo-cline.deniedCommands": [],
  "rust-analyzer.workspace.discoverConfig": null,
  "terminal.integrated.env.linux": {
    "PATH": "${env:PATH}:/run/current-system/sw/bin"
  },
  "explorer.confirmDragAndDrop": false,
  "notebook.lineNumbers": "on",
  "workbench.colorTheme": "NoctaliaTheme",
  "vim.showMarksInGutter": false,
  "vim.foldfix": true,
  "vim.surround": true,
  "vim.easymotion": true,
  "vim.easymotionKeys": "asdghklqwertyuiopzxcvbnmfj",
  "vim.leader": "<space>",
